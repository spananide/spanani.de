{
  "name": "claude-stand",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "VAPID_SUBJECT": "mailto:webmaster@spanani.de" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "claude-stand-db",
      "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "4203", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
